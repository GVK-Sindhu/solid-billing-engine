{
  "name": "solid-billing-engine",
  "version": "1.0.0",
  "description": "Refactored Subscription Billing Engine using SOLID Principles and Hexagonal Architecture",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/server.js",
    "dev": "ts-node src/api/server.ts",
    "test": "jest tests/unit --colors",
    "test:unit": "jest tests/unit --coverage --colors",
    "test:integration": "jest tests/integration --runInBand --colors",
    "test:coverage": "jest tests/unit --coverage --colors"
  },
  "keywords": [
    "solid",
    "hexagonal-architecture",
    "ports-and-adapters",
    "dependency-injection",
    "refactoring"
  ],
  "author": "",
